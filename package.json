{
  "name": "@schreib-magie/ralph-node-red",
  "private": true,
  "version": "1.0.0",
  "description": "Node-RED configuration for orchestrating pi ralph-loop subagents (planner/builder/reviewer/refactor/improver/fixer) over docs/tickets.md.",
  "scripts": {
    "start": "node-red -u . flows.json",
    "init": "node bin/init.js",
    "test": "node --test"
  },
  "node-red": {
