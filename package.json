      "ralph-run-agent": "nodes/ralph-run-agent.js",
      "ralph-discover-agents": "nodes/ralph-discover-agents.js",
      "ralph-run-verify": "nodes/ralph-run-verify.js"
    }
  },
  "dependencies": {
    "node-red": "^4.0.9",
    "node-red-dashboard": "^3.6.5"
  }
}
