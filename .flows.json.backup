        "type": "function",
        "z": "flow_loop",
        "name": "report error (loop)",
        "func": "const err = msg.error || {};\nconst sourceName = (err.source && (err.source.name || err.source.type)) || 'unknown node';\nnode.warn(`[ralph-loop] Fehler in Iteration ${msg.ralph ? msg.ralph.iteration : '?'} in \"${sourceName}\": ${err.message}`);\nnode.status({ fill: \"red\", shape: \"dot\", text: `error: ${sourceName}` });\nmsg.ralphError = {\n  node: sourceName,\n  message: err.message || String(err),\n  iteration: (msg.ralph && msg.ralph.iteration) || 0,\n};\nreturn msg;",
        "outputs": 1,
