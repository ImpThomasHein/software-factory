        "z": "flow_finish",
        "name": "check verify result",
        "func": "const lib = global.get('ralphLib');\nconst verify = msg.ralph.verify;\nconst attempt = msg.ralph.verifyAttempt || 1;\nconst maxAttempts = msg.ralph.verifyMaxAttempts || 5;\n\nif (verify.success) {\n  node.status({ fill: \"green\", shape: \"dot\", text: `verify OK (Versuch ${attempt})` });\n  msg.ralph.verifyFinal = { success: true, attempts: attempt, output: verify.output, command: verify.command };\n  return [msg, null];\n}\n\nif (global.get('ralphStopRequested')) {\n  node.status({ fill: \"grey\", shape: \"ring\", text: \"verify: stopped\" });\n  msg.ralph.verifyFinal = { success: false, attempts: attempt, output: verify.output, command: verify.command, stopped: true };\n  return [msg, null];\n}\n\nif (attempt >= maxAttempts) {\n  node.status({ fill: \"red\", shape: \"ring\", text: `verify FEHLGESCHLAGEN (${attempt} Versuche)` });\n  msg.ralph.verifyFinal = { success: false, attempts: attempt, output: verify.output, command: verify.command };\n  return [msg, null];\n}\n\nnode.status({ fill: \"yellow\", shape: \"dot\", text: `verify failed, starte ralph-ci-fixer (Versuch ${attempt + 1})` });\nmsg.ralph.verifyAttempt = attempt + 1;\nmsg.ralph.agentName = 'ralph-ci-fixer';\nmsg.ralph.task = lib.tasks.buildCiFixerTask(verify.command, verify.output, attempt);\nmsg.payload = msg.ralph.task;\nreturn [null, msg];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 380,
        "wires": [
            [
                "finalize_summary"
            ],
            [
                "run_agent_ci_fixer"
            ]
        ]
    },
    {
        "id": "run_agent_ci_fixer",
        "type": "ralph-run-agent",
        "z": "flow_finish",
        "name": "ralph-ci-fixer",
        "agentName": "",
        "agentNameFromMsg": true,
        "cwd": "ralph.cwd",
        "cwdType": "msg",
        "modelOverride": "",
        "toolsOverride": "",
