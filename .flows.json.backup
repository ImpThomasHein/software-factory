    {
        "id": "http_in_start",
        "type": "http in",
        "z": "flow_start",
        "name": "POST /ralph/start",
        "url": "/ralph/start",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 80,
        "wires": [
            [
                "fn_prep_http"
            ]
        ]
    },
    {
        "id": "fn_prep_http",
        "type": "function",
        "z": "flow_start",
        "name": "prepare http start",
        "func": "const loops = Number.parseInt(msg.payload && msg.payload.loops, 10) || 1;\nconst repoRoot = (msg.payload && msg.payload.repoRoot) || global.get('ralphRepoRoot');\nconst verifyCommand = (msg.payload && msg.payload.verifyCommand) || undefined;\nconst respMsg = { ...msg, payload: { status: \"accepted\", loops, repoRoot, verifyCommand }, statusCode: 202 };\nconst startMsg = { payload: { loops, repoRoot, verifyCommand } };\nnode.send([respMsg, startMsg]);\nreturn null;",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 80,
        "wires": [
            [
                "http_resp_start"
            ],
            [
                "init_loop_state"
            ]
        ]
    },
    {
        "id": "http_resp_start",
        "type": "http response",
        "z": "flow_start",
        "name": "202 Accepted",
        "statusCode": "",
        "headers": {},
        "x": 600,
        "y": 60,
        "wires": []
    },
    {
        "id": "ui_form_start",
        "type": "ui_form",
        "z": "flow_start",
        "name": "Start Loop",
        "label": "Start Ralph Loop",
        "group": "ui_group_control",
        "order": 1,
        "width": 0,
        "height": 0,
        "options": [
            {
                "label": "Iterationen",
                "value": "loops",
                "type": "number",
                "required": true,
                "rows": null
            },
            {
                "label": "Repo-Pfad",
                "value": "repoRoot",
                "type": "text",
                "required": false,
                "rows": null
            },
            {
                "label": "Verify-Kommando (Build/Test)",
                "value": "verifyCommand",
                "type": "text",
                "required": false,
                "rows": null
            }
        ],
        "formValue": {
            "loops": 3,
            "repoRoot": "",
            "verifyCommand": ""
        },
        "payload": "",
        "submit": "Start",
        "cancel": "Abbrechen",
        "topic": "start",
        "topicType": "str",
        "splitLayout": "",
        "className": "",
        "x": 150,
        "y": 160,
        "wires": [
            [
                "fn_prep_dashboard_start"
            ]
        ]
    },
    {
        "id": "fn_prep_dashboard_start",
        "type": "function",
        "z": "flow_start",
        "name": "normalize dashboard start",
        "func": "const loops = Number.parseInt(msg.payload && msg.payload.loops, 10) || 1;\nconst repoRoot = (msg.payload && msg.payload.repoRoot) || global.get('ralphRepoRoot');\nconst verifyCommand = (msg.payload && msg.payload.verifyCommand) || undefined;\nmsg.payload = { loops, repoRoot, verifyCommand };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 160,
        "wires": [
            [
                "init_loop_state"
            ]
        ]
    },
    {
        "id": "init_loop_state",
        "type": "function",
        "z": "flow_start",
        "name": "init loop state",
        "func": "const path = global.get('path');\nconst tasksLib = global.get('ralphLib').tasks;\nconst loops = Math.max(1, Number(msg.payload.loops) || 1);\nconst cwd = path.resolve(msg.payload.repoRoot || global.get('ralphRepoRoot'));\nconst AC = global.get('AbortController');\nconst abortController = new AC();\nglobal.set('ralphAbortController', abortController);\nglobal.set('ralphStopRequested', false);\nglobal.set('ralphLoopRunning', true);\nconst sharedPrompt = await tasksLib.loadSharedPrompt(cwd, '.pi/ralph-loop/system-prompt.md');\nmsg.ralph = {\n  cwd, sharedPrompt, abortController,\n  iteration: 1, total: loops,\n  completedTickets: 0, attemptedTickets: 0,\n  changedFiles: [], startedAt: Date.now(),\n  verifyCommand: msg.payload.verifyCommand || global.get('ralphVerifyCommand'),\n  verifyMaxAttempts: global.get('ralphVerifyMaxAttempts'),\n  verifyAttempt: 1,\n};\nnode.status({ fill: \"blue\", shape: \"dot\", text: `starting: ${loops} iterations` });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 160,
        "wires": [
            [
                "discover_agents"
            ]
        ]
    },
    {
        "id": "discover_agents",
        "type": "ralph-discover-agents",
        "z": "flow_start",
        "name": "discover ralph agents",
        "cwd": "ralph.cwd",
        "cwdType": "msg",
        "requireDefault": true,
        "x": 860,
        "y": 160,
        "wires": [
            [
                "linkout_start_loop_2"
            ]
        ]
    },
    {
        "id": "load_frontier",
        "type": "function",
        "z": "flow_loop",
        "name": "load frontier ticket",
        "func": "const fs = global.get('fsp');\nconst path = global.get('path');\nconst { parseTickets, findFrontier } = global.get('ralphLib').tickets;\n\nif (global.get('ralphStopRequested')) {\n  msg.ralph.reason = 'stopped';\n  return [null, msg];\n}\n\nconst ticketsPath = path.join(msg.ralph.cwd, 'docs/tickets.md');\nconst content = await fs.readFile(ticketsPath, 'utf8');\nconst tickets = parseTickets(content);\nconst ticket = findFrontier(tickets);\n\nif (!ticket) {\n  msg.ralph.reason = 'no-frontier';\n  return [null, msg];\n}\n\nmsg.ralph.ticket = ticket;\nmsg.ralph.ticketsContent = content;\nmsg.ralph.remainingTickets = tickets.filter((t) => !t.done).length;\nmsg.ralph.startedIterationAt = Date.now();\nnode.status({ fill: \"blue\", shape: \"dot\", text: `#${ticket.id} ${ticket.title}` });\nreturn [msg, null];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 80,
        "wires": [
            [
                "build_planner_task"
            ],
            [
                "linkout_loop_finished_4"
            ]
        ]
    },
    {
        "id": "build_planner_task",
        "type": "function",
        "z": "flow_loop",
        "name": "build planner task",
        "func": "const { plannerTask } = global.get('ralphLib').tasks;\nmsg.ralph.agentName = 'ralph-planner';\nmsg.ralph.task = plannerTask(msg.ralph.ticket);\nmsg.payload = msg.ralph.task;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 80,
        "wires": [
            [
                "run_agent_planner"
            ]
        ]
    },
    {
        "id": "run_agent_planner",
        "type": "ralph-run-agent",
        "z": "flow_loop",
        "name": "ralph-planner",
        "agentName": "",
        "agentNameFromMsg": true,
        "cwd": "ralph.cwd",
        "cwdType": "msg",
        "modelOverride": "",
        "toolsOverride": "",
        "sharedPromptFromMsg": true,
        "x": 700,
        "y": 80,
        "wires": [
            [
                "build_builder_task"
            ],
            [
                "linkout_agent_event_f"
            ]
        ]
    },
    {
        "id": "build_builder_task",
        "type": "function",
        "z": "flow_loop",
        "name": "build builder task",
        "func": "const { builderTask } = global.get('ralphLib').tasks;\nmsg.ralph.plannerOutput = msg.payload;\nmsg.ralph.plannerResult = msg.ralph.result;\nmsg.ralph.agentName = 'ralph-builder';\nmsg.ralph.task = builderTask(msg.ralph.ticket, msg.ralph.plannerOutput);\nmsg.payload = msg.ralph.task;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 80,
        "wires": [
            [
                "run_agent_builder"
            ]
        ]
    },
    {
        "id": "run_agent_builder",
        "type": "ralph-run-agent",
        "z": "flow_loop",
        "name": "ralph-builder",
        "agentName": "",
        "agentNameFromMsg": true,
        "cwd": "ralph.cwd",
        "cwdType": "msg",
        "modelOverride": "",
        "toolsOverride": "",
        "sharedPromptFromMsg": true,
        "x": 1140,
        "y": 80,
        "wires": [
            [
                "build_reviewer_task"
            ],
            [
                "linkout_agent_event_g"
            ]
        ]
    },
    {
        "id": "build_reviewer_task",
        "type": "function",
        "z": "flow_loop",
        "name": "build reviewer task",
        "func": "const { reviewerTask } = global.get('ralphLib').tasks;\nmsg.ralph.builderOutput = msg.payload;\nmsg.ralph.builderResult = msg.ralph.result;\nmsg.ralph.agentName = 'ralph-reviewer';\nmsg.ralph.reviewAttempt = 1;\nmsg.ralph.task = reviewerTask(msg.ralph.ticket, msg.ralph.builderOutput);\nmsg.payload = msg.ralph.task;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1360,
        "y": 80,
        "wires": [
            [
                "run_agent_reviewer"
            ]
        ]
    },
    {
        "id": "run_agent_reviewer",
        "type": "ralph-run-agent",
        "z": "flow_loop",
        "name": "ralph-reviewer",
        "agentName": "",
        "agentNameFromMsg": true,
        "cwd": "ralph.cwd",
        "cwdType": "msg",
        "modelOverride": "",
        "toolsOverride": "",
        "sharedPromptFromMsg": true,
        "x": 1580,
        "y": 80,
        "wires": [
            [
                "check_verdict"
            ],
            [
                "linkout_agent_event_h"
            ]
        ]
    },
    {
        "id": "check_verdict",
        "type": "function",
        "z": "flow_loop",
        "name": "check verdict",
        "func": "const { parseVerdict } = global.get('ralphLib').verdict;\nconst { buildFixerTask } = global.get('ralphLib').tasks;\nmsg.ralph.reviewerOutput = msg.payload;\nmsg.ralph.reviewerResult = msg.ralph.result;\nconst verdict = parseVerdict(msg.ralph.reviewerOutput);\nmsg.ralph.verdict = verdict;\n\nconst attempt = msg.ralph.reviewAttempt || 1;\nif (verdict === 'READY' || attempt >= 3) {\n  node.status({ fill: verdict === 'READY' ? \"green\" : \"yellow\", shape: \"dot\", text: verdict });\n  return [msg, null];\n}\n\nconst nextAttempt = attempt + 1;\nmsg.ralph.reviewAttempt = nextAttempt;\nmsg.ralph.agentName = 'ralph-fixer';\nmsg.ralph.task = buildFixerTask(msg.ralph.ticket.id, msg.ralph.ticket.title, msg.ralph.plannerOutput, msg.ralph.reviewerOutput, nextAttempt);\nmsg.payload = msg.ralph.task;\nnode.status({ fill: \"yellow\", shape: \"dot\", text: `NEEDS_WORK, retry ${nextAttempt}` });\nreturn [null, msg];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1800,
        "y": 80,
        "wires": [
            [
                "finalize_iteration"
            ],
            [
                "run_agent_fixer"
            ]
        ]
    },
    {
        "id": "run_agent_fixer",
        "type": "ralph-run-agent",
        "z": "flow_loop",
        "name": "ralph-fixer",
        "agentName": "",
        "agentNameFromMsg": true,
        "cwd": "ralph.cwd",
        "cwdType": "msg",
        "modelOverride": "",
        "toolsOverride": "",
        "sharedPromptFromMsg": true,
        "x": 2020,
        "y": 180,
        "wires": [
            [
                "build_rereview_task"
            ],
            [
                "linkout_agent_event_i"
            ]
        ]
    },
    {
        "id": "build_rereview_task",
        "type": "function",
        "z": "flow_loop",
        "name": "build re-review task",
        "func": "const { reviewerTask } = global.get('ralphLib').tasks;\nmsg.ralph.fixerOutput = msg.payload;\nmsg.ralph.fixerResult = msg.ralph.result;\nmsg.ralph.agentName = 'ralph-reviewer';\nmsg.ralph.task = reviewerTask(msg.ralph.ticket, msg.ralph.fixerOutput);\nmsg.payload = msg.ralph.task;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2240,
        "y": 180,
        "wires": [
            [
                "run_agent_reviewer"
            ]
        ]
    },
    {
        "id": "finalize_iteration",
        "type": "function",
        "z": "flow_loop",
        "name": "finalize iteration",
        "func": "const fs = global.get('fsp');\nconst path = global.get('path');\nconst lib = global.get('ralphLib');\n\nconst ticket = msg.ralph.ticket;\nlet ticketMarkedDone = false;\nif (msg.ralph.verdict === 'READY') {\n  const updated = lib.tickets.setTicketDone(msg.ralph.ticketsContent, ticket.id);\n  await fs.writeFile(path.join(msg.ralph.cwd, 'docs/tickets.md'), updated, 'utf8');\n  ticketMarkedDone = true;\n  msg.ralph.completedTickets = (msg.ralph.completedTickets || 0) + 1;\n}\nmsg.ralph.attemptedTickets = (msg.ralph.attemptedTickets || 0) + 1;\n\nconst changed = await lib.git.detectChangedFiles(msg.ralph.cwd);\nmsg.ralph.changedFiles = [...new Set([...(msg.ralph.changedFiles || []), ...changed])];\n\nconst testRunResult = await lib.git.runTestsOrNull(msg.ralph.cwd).catch((e) => `tests failed: ${e.message}`);\nconst linesOfCode = await lib.fsUtils.countFiles(path.join(msg.ralph.cwd, 'application/src'));\nconst linesOfTests = await lib.fsUtils.countTestFiles(path.join(msg.ralph.cwd, 'application'));\n\nconst entry = lib.progress.formatProgressEntry({\n  iteration: msg.ralph.iteration,\n  totalIterations: msg.ralph.total,\n  ticketId: ticket.id,\n  ticketTitle: ticket.title,\n  startedAt: new Date(msg.ralph.startedIterationAt),\n  finishedAt: new Date(),\n  agentOutputs: {\n    planner: msg.ralph.plannerOutput,\n    builder: msg.ralph.builderOutput,\n    reviewer: msg.ralph.reviewerOutput,\n  },\n  verdict: msg.ralph.verdict,\n  ticketMarkedDone,\n  designDecisions: lib.text.extractBullets(msg.ralph.plannerOutput, /design|entscheid/i),\n  recommendations: lib.text.extractBullets(msg.ralph.reviewerOutput, /empfehl|recommend|next/i),\n  testRunResult,\n  devTimeSeconds: Math.round((Date.now() - msg.ralph.startedIterationAt) / 1000),\n  linesOfCode,\n  linesOfTests,\n  keyChanges: changed,\n  keyInsights: lib.text.extractBullets(msg.ralph.reviewerOutput, /insight|erkenntnis|lesson/i),\n});\nawait lib.progress.appendProgress(path.join(msg.ralph.cwd, '.pi/ralph-loop/progress.md'), entry);\n// Per-agent transcripts (.pi/ralph-loop/logs/iter-*.md) and the debug.jsonl trail are\n// now written immediately after each process exits by the ralph-run-agent node itself,\n// so every agent (incl. fixer/refactor/improver) is covered, not just planner/builder/reviewer.\nawait lib.notify.sendNtfyNotification(\n  `Iteration ${msg.ralph.iteration}: ${msg.ralph.verdict}`,\n  `Ticket #${ticket.id}: ${ticket.title}`\n);\n\nmsg.ralph.ticketMarkedDone = ticketMarkedDone;\nmsg.payload = { iteration: msg.ralph.iteration, ticket: { id: ticket.id, title: ticket.title }, verdict: msg.ralph.verdict, ticketMarkedDone };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
