[
    {
        "id": "flow_loop",
        "type": "tab",
        "label": "Ralph Loop (Core Cycle)",
        "disabled": false,
        "info": "The per-ticket agent cycle: planner -> builder -> reviewer -> (fixer/re-review) -> finalize -> advance. Start/meta/telemetry live on separate tabs, wired via Link nodes.",
        "env": []
    },
    {
        "id": "flow_start",
        "type": "tab",
        "label": "Ralph: Start & Control",
        "disabled": false,
        "info": "Loop entry points (HTTP + dashboard form), one-time init/agent discovery, and the Stop button.",
        "env": []
    },
    {
        "id": "flow_meta",
        "type": "tab",
        "label": "Ralph: Meta Agents",
        "disabled": false,
        "info": "Runs every 5th iteration: refactor pass, then improve pass over accumulated progress notes.",
        "env": []
    },
    {
        "id": "flow_telemetry",
        "type": "tab",
        "label": "Ralph: Live Stream & Progress",
        "disabled": false,
        "info": "Dashboard live-stream feed and ticket-progress gauge, fed from every agent run.",
        "env": []
    },
    {
        "id": "flow_finish",
        "type": "tab",
        "label": "Ralph: Finish & Summary",
        "disabled": false,
        "info": "Terminal state: build and publish the end-of-loop summary.",
        "env": []
    },
