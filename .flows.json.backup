    {
        "id": "finalize_summary",
        "type": "function",
        "z": "flow_finish",
        "name": "finalize summary (with verify)",
        "func": "const lib = global.get('ralphLib');\nconst base = msg.ralph.loopSummary;\nconst vf = msg.ralph.verifyFinal;\nconst attemptsLabel = `${vf.attempts} Versuch${vf.attempts === 1 ? '' : 'en'}`;\nmsg.payload = {\n  ...base,\n  reason: vf.stopped\n    ? `${base.reason} \u00b7 Verify gestoppt nach ${attemptsLabel}`\n    : vf.success\n      ? `${base.reason} \u00b7 Verify OK (${attemptsLabel})`\n      : `${base.reason} \u00b7 Verify FEHLGESCHLAGEN nach ${attemptsLabel}`,\n  verify: { success: vf.success, attempts: vf.attempts, command: vf.command, stopped: !!vf.stopped },\n};\ntry {\n  await lib.notify.sendNtfyNotification(\n    vf.success ? 'Ralph Loop: Verify OK' : 'Ralph Loop: Verify fehlgeschlagen',\n    `${vf.command}${vf.success ? '' : '\\n' + (vf.output || '').slice(-500)}`\n  );\n} catch (_) { /* notification best-effort */ }\nglobal.set('ralphAbortController', null);\nglobal.set('ralphLoopRunning', false);\nglobal.set('ralphStopRequested', false);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
