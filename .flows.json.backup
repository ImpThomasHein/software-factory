    {
        "id": "fn_finalize_error",
        "type": "function",
        "z": "flow_finish",
        "name": "finalize error",
        "func": "if (!msg.ralphError) {\n  const err = msg.error || {};\n  const sourceName = (err.source && (err.source.name || err.source.type)) || 'unknown node';\n  msg.ralphError = {\n    node: sourceName,\n    message: err.message || String(err),\n    iteration: (msg.ralph && msg.ralph.iteration) || 0,\n  };\n}\nconst lib = global.get('ralphLib');\nglobal.set('ralphAbortController', null);\nglobal.set('ralphStopRequested', false);\nglobal.set('ralphLoopRunning', false);\nconst e = msg.ralphError || {};\nmsg.payload = {\n  reason: `error in \"${e.node}\": ${e.message}`,\n  iterations: e.iteration || 0,\n  attemptedTickets: (msg.ralph && msg.ralph.attemptedTickets) || 0,\n  completedTickets: (msg.ralph && msg.ralph.completedTickets) || 0,\n  durationSec: msg.ralph ? Math.round((Date.now() - msg.ralph.startedAt) / 1000) : 0,\n};\ntry {\n  await lib.notify.sendNtfyNotification('Ralph Loop Fehler', JSON.stringify(msg.payload));\n} catch (_) { /* notification best-effort */ }\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
